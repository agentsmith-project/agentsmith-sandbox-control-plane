# ASBCP service 配置
# 复制此文件为 config.env 并修改

# Registry 配置
REGISTRY=localhost:5001
IMAGE_NAME=agentsmith-sandbox-control-plane
# Defaults to the repo-root VERSION file; set only for local override.
VERSION=

# 构建配置
BUILDX_BUILDER=sandbox-builder
CACHE_DIR=/tmp/.buildx-cache-asbcp
PLATFORM=linux/amd64

# 代理配置（可选）
HTTP_PROXY=
HTTPS_PROXY=

# Kind 配置（可选）
KIND_CLUSTER=sandbox-cluster
AUTO_LOAD_TO_KIND=false

# Registry 推送配置（可选）
AUTO_PUSH=false
REGISTRY_USERNAME=
REGISTRY_PASSWORD=
